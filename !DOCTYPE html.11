<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>FinTrack Pro - Smart Money Manager</title>
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- Firebase SDKs -->
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>
    <!-- SheetJS for Excel/CSV export -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background: radial-gradient(circle at 10% 20%, #0a0f1e, #020408);
            min-height: 100vh;
            padding: 20px;
            color: #eef2ff;
        }

        /* Glassmorphism containers */
        .glass-card {
            background: rgba(20, 30, 45, 0.6);
            backdrop-filter: blur(14px);
            border-radius: 2rem;
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 20px 35px -12px rgba(0, 0, 0, 0.5);
            transition: transform 0.25s ease, box-shadow 0.25s;
        }

        .glass-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 25px 40px -14px rgba(0, 0, 0, 0.6);
        }

        button, .btn-icon {
            cursor: pointer;
            background: rgba(255, 255, 255, 0.08);
            border: none;
            border-radius: 2rem;
            padding: 0.65rem 1.3rem;
            color: white;
            font-weight: 500;
            transition: all 0.2s ease;
            backdrop-filter: blur(4px);
        }

        button:hover {
            background: rgba(79, 139, 255, 0.8);
            transform: scale(1.02);
        }

        input, select, textarea {
            background: rgba(10, 20, 30, 0.75);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 1.2rem;
            padding: 0.7rem 1rem;
            color: white;
            font-size: 0.9rem;
            outline: none;
            transition: 0.2s;
        }

        input:focus, select:focus, textarea:focus {
            border-color: #5f9eff;
            box-shadow: 0 0 10px rgba(79, 139, 255, 0.3);
        }

        /* Floating action button */
        .fab {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            background: linear-gradient(135deg, #5f9eff, #2c5fcc);
            width: 64px;
            height: 64px;
            border-radius: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.4);
            z-index: 100;
            transition: all 0.25s;
            cursor: pointer;
        }

        .fab:hover {
            transform: scale(1.08);
            background: #3a74e0;
        }

        /* Transaction Cards */
        .tx-card {
            background: rgba(25, 35, 55, 0.7);
            backdrop-filter: blur(8px);
            border-radius: 1.5rem;
            padding: 1rem;
            margin-bottom: 1rem;
            border-left: 5px solid #5f9eff;
            transition: all 0.2s;
            animation: fadeSlideUp 0.3s ease;
        }

        @keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .tx-card.overdue {
            border-left-color: #ff5c5c;
            background: rgba(255, 80, 80, 0.2);
        }

        .tx-card.upcoming {
            border-left-color: #ffb347;
            background: rgba(255, 180, 70, 0.12);
        }

        .badge {
            font-size: 0.7rem;
            padding: 0.2rem 0.8rem;
            border-radius: 1rem;
            background: rgba(0,0,0,0.5);
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.75);
            backdrop-filter: blur(8px);
            align-items: center;
            justify-content: center;
            z-index: 200;
            animation: fadeIn 0.2s;
        }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        .modal-content {
            max-width: 520px;
            width: 90%;
            background: #0f1622e6;
            border-radius: 2rem;
            padding: 1.8rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
        }

        .stat-card {
            background: rgba(0,0,0,0.45);
            border-radius: 1.5rem;
            padding: 1rem;
            text-align: center;
            backdrop-filter: blur(4px);
            transition: 0.2s;
        }

        .stat-card i { font-size: 1.5rem; margin-bottom: 0.4rem; color: #7aa9ff; }

        .activity-item {
            font-size: 0.8rem;
            padding: 0.6rem;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .spinner {
            width: 40px;
            height: 40px;
            border: 4px solid rgba(255,255,255,0.2);
            border-top: 4px solid #5f9eff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 20px auto;
        }

        @keyframes spin { to { transform: rotate(360deg); } }

        @media (max-width: 700px) {
            body { padding: 12px; }
            .stats-grid { grid-template-columns: 1fr 1fr; gap: 0.7rem; }
            .fab { width: 54px; height: 54px; bottom: 1.2rem; right: 1.2rem; font-size: 1.5rem; }
        }
    </style>
</head>
<body>

<!-- AUTH CONTAINER -->
<div id="authContainer" style="display: flex; justify-content: center; align-items: center; min-height: 90vh;">
    <div class="glass-card" style="width: 400px; padding: 2rem; text-align: center;">
        <h2 style="margin-bottom: 0.5rem;"><i class="fas fa-coins"></i> FinTrack Pro</h2>
        <p style="margin-bottom: 1.5rem; font-size: 0.8rem;">Smart Financial Manager</p>
        <div id="loginPanel">
            <input type="email" id="loginEmail" placeholder="Email address" style="width:100%; margin: 10px 0;">
            <input type="password" id="loginPassword" placeholder="Password" style="width:100%; margin: 10px 0;">
            <button id="loginBtn" style="width:100%; margin-top: 10px;"><i class="fas fa-sign-in-alt"></i> Login</button>
            <p style="margin-top: 20px;">New user? <span id="showSignup" style="color:#5f9eff; cursor:pointer; font-weight:500;">Create account</span></p>
        </div>
        <div id="signupPanel" style="display:none;">
            <input type="text" id="signupName" placeholder="Full Name" style="width:100%; margin: 10px 0;">
            <input type="email" id="signupEmail" placeholder="Email" style="width:100%; margin: 10px 0;">
            <input type="password" id="signupPassword" placeholder="Password (min 6 chars)" style="width:100%; margin: 10px 0;">
            <button id="signupBtn" style="width:100%;"><i class="fas fa-user-plus"></i> Sign Up</button>
            <p style="margin-top: 20px;">Already have account? <span id="showLogin" style="color:#5f9eff; cursor:pointer; font-weight:500;">Login</span></p>
        </div>
        <div id="authError" style="color:#ff8a7a; margin-top: 15px; font-size:0.85rem;"></div>
    </div>
</div>

<!-- MAIN APP DASHBOARD -->
<div id="appContainer" style="display: none;">
    <div class="glass-card" style="padding: 1rem 1.8rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div>
            <h2><i class="fas fa-chart-line"></i> FinTrack</h2>
            <p>Welcome back, <strong id="displayUsername">User</strong>!</p>
        </div>
        <div>
            <button id="exportCSVBtn"><i class="fas fa-file-excel"></i> Export CSV</button>
            <button id="logoutBtn" style="margin-left: 10px; background:#4a4e69;"><i class="fas fa-sign-out-alt"></i> Logout</button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid" style="margin-bottom: 1.8rem;">
        <div class="stat-card"><i class="fas fa-hand-holding-usd"></i><br>Total Given<br><span id="totalGiven" style="font-size:1.4rem; font-weight:bold;">0</span></div>
        <div class="stat-card"><i class="fas fa-receipt"></i><br>Total Taken<br><span id="totalTaken" style="font-size:1.4rem; font-weight:bold;">0</span></div>
        <div class="stat-card"><i class="fas fa-clock"></i><br>Pending<br><span id="pendingAmount" style="font-size:1.4rem; font-weight:bold;">0</span></div>
        <div class="stat-card"><i class="fas fa-check-circle"></i><br>Completed<br><span id="completedCount" style="font-size:1.4rem; font-weight:bold;">0</span></div>
        <div class="stat-card"><i class="fas fa-bell"></i><br>Upcoming Due<br><span id="upcomingDueCount" style="font-size:1.4rem; font-weight:bold;">0</span></div>
    </div>

    <!-- Search & Filters -->
    <div class="glass-card" style="padding: 1rem 1.2rem; margin-bottom: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.7rem; align-items: center;">
        <input type="text" id="searchName" placeholder="🔍 Search by person name" style="flex:2; min-width:140px;">
        <select id="filterType"><option value="">All Types</option><option value="Given">💰 Given</option><option value="Taken">📥 Taken</option></select>
        <select id="filterStatus"><option value="">All Status</option><option value="pending">⏳ Pending</option><option value="paid">✅ Paid</option></select>
        <input type="date" id="filterDate" placeholder="Filter date">
        <button id="resetFilterBtn"><i class="fas fa-sync-alt"></i> Reset</button>
    </div>

    <!-- Real-time Update Banner -->
    <div id="liveUpdateMsg" class="glass-card" style="padding: 0.6rem 1rem; margin-bottom: 1rem; font-size:0.8rem; background:#1e2a3a;"></div>

    <!-- Transactions List -->
    <div id="transactionsList" style="max-height: 52vh; overflow-y: auto; padding-right: 5px;"></div>

    <!-- Activity Log -->
    <div class="glass-card" style="margin-top: 1.8rem; padding: 1rem;">
        <h4><i class="fas fa-history"></i> Live Activity Feed</h4>
        <div id="activityLog" style="max-height: 160px; overflow-y: auto; font-size: 0.75rem;"></div>
    </div>
</div>

<!-- Transaction Modal (Add/Edit) -->
<div id="transactionModal" class="modal">
    <div class="modal-content glass-card">
        <h3 id="modalTitle"><i class="fas fa-plus-circle"></i> Add Transaction</h3>
        <input type="hidden" id="editId">
        <input type="text" id="personName" placeholder="Person Name *" style="width:100%; margin: 8px 0;">
        <input type="number" id="amount" placeholder="Amount *" step="0.01" style="width:100%; margin: 8px 0;">
        <select id="txType" style="width:100%; margin: 8px 0;">
            <option value="Given">Given (I lent money)</option>
            <option value="Taken">Taken (I borrowed)</option>
        </select>
        <input type="date" id="txDate" style="width:100%; margin: 8px 0;">
        <input type="date" id="dueDate" style="width:100%; margin: 8px 0;">
        <textarea id="notes" placeholder="Notes (optional)" rows="2" style="width:100%; margin: 8px 0;"></textarea>
        <div style="display: flex; gap: 12px; margin-top: 16px;">
            <button id="saveTransactionBtn" style="flex:1;"><i class="fas fa-save"></i> Save</button>
            <button id="closeModalBtn" style="background:#4a4e69;"><i class="fas fa-times"></i> Cancel</button>
        </div>
        <div id="markPaidDiv" style="margin-top: 12px; display: none;">
            <button id="markAsPaidBtn" style="background:#2e7d32; width:100%;"><i class="fas fa-check-circle"></i> Mark as Paid</button>
        </div>
    </div>
</div>

<!-- Floating Add Button -->
<div class="fab" id="floatingAddBtn"><i class="fas fa-plus"></i></div>

<script>
    // ==================== FIREBASE CONFIGURATION (UPDATED) ====================
    const firebaseConfig = {
        apiKey: "AIzaSyBmFs83pn3vtaO5vg2MAaBTQYXqgP-lsBM",
        authDomain: "digktkg.firebaseapp.com",
        databaseURL: "https://digktkg-default-rtdb.firebaseio.com",
        projectId: "digktkg",
        storageBucket: "digktkg.firebasestorage.app",
        messagingSenderId: "593886465633",
        appId: "1:593886465633:web:6c09f44899146eb534e420",
        measurementId: "G-GEEQZNHZ2Y"
    };

    // Initialize Firebase
    firebase.initializeApp(firebaseConfig);
    const auth = firebase.auth();
    const db = firebase.database();

    let currentUser = null;
    let transactionsRef = null;
    let activityRef = null;
    let allTransactions = [];
    let activityList = [];

    // DOM Elements
    const authContainer = document.getElementById('authContainer');
    const appContainer = document.getElementById('appContainer');
    const loginPanel = document.getElementById('loginPanel');
    const signupPanel = document.getElementById('signupPanel');
    const authError = document.getElementById('authError');

    // Helper functions
    function showLoaderToast() {} // visual handled by spinner in container if needed

    async function addActivity(action) {
        if (!currentUser) return;
        const username = localStorage.getItem('fintrack_username') || currentUser.email?.split('@')[0] || 'User';
        await db.ref(`users/${currentUser.uid}/activityLog`).push({
            action: action,
            username: username,
            timestamp: Date.now()
        });
    }

    // Attach realtime listeners
    function attachRealtimeListeners(userId) {
        if (transactionsRef) transactionsRef.off();
        if (activityRef) activityRef.off();
        transactionsRef = db.ref(`users/${userId}/transactions`);
        activityRef = db.ref(`users/${userId}/activityLog`);

        transactionsRef.on('value', (snapshot) => {
            const data = snapshot.val();
            allTransactions = data ? Object.entries(data).map(([id, val]) => ({ id, ...val })) : [];
            applyFiltersAndRender();
            updateDashboardStats();
            const liveDiv = document.getElementById('liveUpdateMsg');
            if (liveDiv) {
                liveDiv.innerHTML = `<i class="fas fa-broadcast-tower"></i> Live sync • Updated by someone • ${new Date().toLocaleTimeString()}`;
                setTimeout(() => { if(liveDiv) liveDiv.style.opacity = '0.9'; }, 100);
            }
        });

        activityRef.on('value', (snapshot) => {
            const logs = snapshot.val();
            activityList = logs ? Object.values(logs).sort((a,b) => b.timestamp - a.timestamp).slice(0, 15) : [];
            renderActivityLog();
        });
    }

    function renderActivityLog() {
        const container = document.getElementById('activityLog');
        if (!container) return;
        if (!activityList.length) {
            container.innerHTML = '<div class="activity-item"><i class="fas fa-info-circle"></i> No activity yet</div>';
            return;
        }
        container.innerHTML = activityList.map(log => `
            <div class="activity-item">
                <i class="fas fa-user-edit"></i> <strong>${escapeHtml(log.username)}</strong> ${escapeHtml(log.action)} 
                <span style="float:right; opacity:0.6;">${new Date(log.timestamp).toLocaleString()}</span>
            </div>
        `).join('');
    }

    function updateDashboardStats() {
        let totalGiven = 0, totalTaken = 0, pending = 0, completed = 0, upcomingDue = 0;
        const today = new Date().toISOString().slice(0,10);
        allTransactions.forEach(tx => {
            if (tx.type === 'Given') totalGiven += tx.amount;
            else totalTaken += tx.amount;
            if (tx.status === 'paid') completed++;
            else {
                pending += tx.amount;
                // Upcoming due check (within next 7 days excluding overdue)
                if (tx.dueDate && tx.status !== 'paid') {
                    const dueDateStr = tx.dueDate;
                    if (dueDateStr >= today && (new Date(dueDateStr) - new Date(today)) <= 7 * 86400000) upcomingDue++;
                }
            }
        });
        document.getElementById('totalGiven').innerText = totalGiven.toFixed(2);
        document.getElementById('totalTaken').innerText = totalTaken.toFixed(2);
        document.getElementById('pendingAmount').innerText = pending.toFixed(2);
        document.getElementById('completedCount').innerText = completed;
        document.getElementById('upcomingDueCount').innerText = upcomingDue;
    }

    function applyFiltersAndRender() {
        const search = document.getElementById('searchName')?.value.toLowerCase() || '';
        const typeFilter = document.getElementById('filterType')?.value || '';
        const statusFilter = document.getElementById('filterStatus')?.value || '';
        const dateFilter = document.getElementById('filterDate')?.value || '';
        let filtered = [...allTransactions];
        if (search) filtered = filtered.filter(t => t.personName?.toLowerCase().includes(search));
        if (typeFilter) filtered = filtered.filter(t => t.type === typeFilter);
        if (statusFilter) filtered = filtered.filter(t => (statusFilter === 'paid' ? t.status === 'paid' : t.status !== 'paid'));
        if (dateFilter) filtered = filtered.filter(t => t.date === dateFilter);
        renderTransactions(filtered);
    }

    function renderTransactions(transactions) {
        const container = document.getElementById('transactionsList');
        if (!container) return;
        if (transactions.length === 0) {
            container.innerHTML = '<div class="glass-card" style="text-align:center; padding:2rem;"><i class="fas fa-inbox"></i> No transactions found</div>';
            return;
        }
        const today = new Date().toISOString().slice(0,10);
        container.innerHTML = transactions.map(tx => {
            let dueClass = '';
            if (tx.status !== 'paid' && tx.dueDate) {
                if (tx.dueDate < today) dueClass = 'overdue';
                else if (tx.dueDate === today || (new Date(tx.dueDate) - new Date(today)) <= 7*86400000) dueClass = 'upcoming';
            }
            return `
                <div class="tx-card ${dueClass}" data-id="${tx.id}">
                    <div style="display:flex; justify-content:space-between; flex-wrap:wrap; align-items:center;">
                        <div><strong><i class="fas fa-user"></i> ${escapeHtml(tx.personName)}</strong> 
                        <span class="badge">${tx.type}</span> ${tx.status === 'paid' ? '<span class="badge" style="background:#2e7d32;">✓ PAID</span>' : ''}</div>
                        <div style="font-size:1.2rem; font-weight:600;">₹${parseFloat(tx.amount).toFixed(2)}</div>
                    </div>
                    <div style="font-size:0.8rem; margin-top: 6px;"><i class="far fa-calendar-alt"></i> Date: ${tx.date} ${tx.dueDate ? `| Due: ${tx.dueDate}` : ''}</div>
                    <div style="font-size:0.75rem; opacity:0.8;"><i class="fas fa-pen"></i> ${tx.notes || 'No notes'}</div>
                    <div style="margin-top: 10px; display:flex; gap: 10px;">
                        <button class="editTxBtn" data-id="${tx.id}" style="padding:4px 14px; background:#3a6ea5;"><i class="fas fa-edit"></i> Edit</button>
                        <button class="deleteTxBtn" data-id="${tx.id}" style="background:#b00020;"><i class="fas fa-trash-alt"></i> Delete</button>
                    </div>
                </div>
            `;
        }).join('');

        // Attach events
        document.querySelectorAll('.editTxBtn').forEach(btn => {
            btn.addEventListener('click', (e) => { const id = btn.getAttribute('data-id'); openEditModal(id); });
        });
        document.querySelectorAll('.deleteTxBtn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                const id = btn.getAttribute('data-id');
                if (confirm('⚠️ Permanently delete this transaction?')) {
                    await transactionsRef.child(id).remove();
                    await addActivity(`Deleted transaction record`);
                }
            });
        });
    }

    function escapeHtml(str) { if(!str) return ''; return String(str).replace(/[&<>]/g, function(m){ if(m==='&') return '&amp;'; if(m==='<') return '&lt;'; if(m==='>') return '&gt;'; return m;}); }

    async function openEditModal(id) {
        const tx = allTransactions.find(t => t.id === id);
        if (!tx) return;
        document.getElementById('modalTitle').innerHTML = '<i class="fas fa-pen"></i> Edit Transaction';
        document.getElementById('editId').value = id;
        document.getElementById('personName').value = tx.personName;
        document.getElementById('amount').value = tx.amount;
        document.getElementById('txType').value = tx.type;
        document.getElementById('txDate').value = tx.date;
        document.getElementById('dueDate').value = tx.dueDate || '';
        document.getElementById('notes').value = tx.notes || '';
        document.getElementById('markPaidDiv').style.display = (tx.status !== 'paid') ? 'block' : 'none';
        document.getElementById('transactionModal').style.display = 'flex';
    }

    function resetModalForm() {
        document.getElementById('editId').value = '';
        document.getElementById('personName').value = '';
        document.getElementById('amount').value = '';
        document.getElementById('txType').value = 'Given';
        document.getElementById('txDate').value = '';
        document.getElementById('dueDate').value = '';
        document.getElementById('notes').value = '';
        document.getElementById('markPaidDiv').style.display = 'none';
        document.getElementById('modalTitle').innerHTML = '<i class="fas fa-plus-circle"></i> Add Transaction';
    }

    // Save transaction (create or update)
    document.getElementById('saveTransactionBtn')?.addEventListener('click', async () => {
        const id = document.getElementById('editId').value;
        const personName = document.getElementById('personName').value.trim();
        const amount = parseFloat(document.getElementById('amount').value);
        const type = document.getElementById('txType').value;
        const date = document.getElementById('txDate').value;
        const dueDate = document.getElementById('dueDate').value || null;
        const notes = document.getElementById('notes').value;
        if (!personName || isNaN(amount) || amount <= 0 || !date) {
            alert('❌ Please fill Person Name, valid Amount (>0) and Date.');
            return;
        }
        const username = localStorage.getItem('fintrack_username') || currentUser.email;
        const txData = { personName, amount, type, date, dueDate, notes, status: 'pending', updatedAt: Date.now(), username };
        if (id) {
            const existing = allTransactions.find(t => t.id === id);
            if (existing) txData.status = existing.status || 'pending';
            await transactionsRef.child(id).update(txData);
            await addActivity(`Edited transaction: ${personName} (${type})`);
        } else {
            const newRef = transactionsRef.push();
            txData.createdAt = Date.now();
            txData.status = 'pending';
            await newRef.set(txData);
            await addActivity(`Added new transaction: ${personName} ${type} ₹${amount}`);
        }
        document.getElementById('transactionModal').style.display = 'none';
        resetModalForm();
    });

    document.getElementById('markAsPaidBtn')?.addEventListener('click', async () => {
        const id = document.getElementById('editId').value;
        if (id) {
            await transactionsRef.child(id).update({ status: 'paid', updatedAt: Date.now() });
            const person = document.getElementById('personName').value;
            await addActivity(`Marked "${person}" as paid ✅`);
            document.getElementById('transactionModal').style.display = 'none';
            resetModalForm();
        }
    });

    document.getElementById('closeModalBtn')?.addEventListener('click', () => {
        document.getElementById('transactionModal').style.display = 'none';
        resetModalForm();
    });

    document.getElementById('floatingAddBtn')?.addEventListener('click', () => {
        resetModalForm();
        document.getElementById('transactionModal').style.display = 'flex';
    });

    // Export CSV
    document.getElementById('exportCSVBtn')?.addEventListener('click', () => {
        const exportData = allTransactions.map(t => ({
            Person: t.personName, Amount: t.amount, Type: t.type, Date: t.date,
            DueDate: t.dueDate || '', Status: t.status === 'paid' ? 'Paid' : 'Pending',
            Notes: t.notes || ''
        }));
        const ws = XLSX.utils.json_to_sheet(exportData);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, 'Transactions');
        XLSX.writeFile(wb, `FinTrack_${currentUser.uid}.xlsx`);
    });

    // Filter event handlers
    document.getElementById('searchName')?.addEventListener('input', applyFiltersAndRender);
    document.getElementById('filterType')?.addEventListener('change', applyFiltersAndRender);
    document.getElementById('filterStatus')?.addEventListener('change', applyFiltersAndRender);
    document.getElementById('filterDate')?.addEventListener('change', applyFiltersAndRender);
    document.getElementById('resetFilterBtn')?.addEventListener('click', () => {
        document.getElementById('searchName').value = '';
        document.getElementById('filterType').value = '';
        document.getElementById('filterStatus').value = '';
        document.getElementById('filterDate').value = '';
        applyFiltersAndRender();
    });

    // Authentication Logic
    document.getElementById('showSignup')?.addEventListener('click', () => {
        loginPanel.style.display = 'none';
        signupPanel.style.display = 'block';
        authError.innerText = '';
    });
    document.getElementById('showLogin')?.addEventListener('click', () => {
        signupPanel.style.display = 'none';
        loginPanel.style.display = 'block';
        authError.innerText = '';
    });
    document.getElementById('loginBtn')?.addEventListener('click', async () => {
        const email = document.getElementById('loginEmail').value;
        const pwd = document.getElementById('loginPassword').value;
        try {
            await auth.signInWithEmailAndPassword(email, pwd);
        } catch(e) { authError.innerText = '❌ ' + e.message; }
    });
    document.getElementById('signupBtn')?.addEventListener('click', async () => {
        const name = document.getElementById('signupName').value.trim();
        const email = document.getElementById('signupEmail').value;
        const pwd = document.getElementById('signupPassword').value;
        if (!name || !email || pwd.length < 6) {
            authError.innerText = 'Please fill full name, valid email & password 6+ chars';
            return;
        }
        try {
            const cred = await auth.createUserWithEmailAndPassword(email, pwd);
            await cred.user.updateProfile({ displayName: name });
            localStorage.setItem('fintrack_username', name);
            await db.ref(`users/${cred.user.uid}/profile`).set({ username: name, email });
            await auth.signOut();
            await auth.signInWithEmailAndPassword(email, pwd);
        } catch(e) { authError.innerText = e.message; }
    });
    document.getElementById('logoutBtn')?.addEventListener('click', () => auth.signOut());

    auth.onAuthStateChanged(async (user) => {
        if (user) {
            currentUser = user;
            let username = user.displayName || user.email?.split('@')[0] || 'User';
            localStorage.setItem('fintrack_username', username);
            document.getElementById('displayUsername').innerText = username;
            authContainer.style.display = 'none';
            appContainer.style.display = 'block';
            attachRealtimeListeners(user.uid);
        } else {
            currentUser = null;
            authContainer.style.display = 'flex';
            appContainer.style.display = 'none';
            if (transactionsRef) transactionsRef.off();
        }
    });
</script>
</body>
</html>